{
    "name": "sgoranov/identity-link-shared",
    "type": "symfony-bundle",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "symfony/framework-bundle": "7.4.*",
        "symfony/serializer": "7.4.*",
        "symfony/runtime": "7.4.*",
        "doctrine/orm": "^3",
        "symfony/validator": "7.4.*",
        "firebase/php-jwt": "^7.0",
        "nyholm/psr7": "^1.8",
        "symfony/security-bundle": "7.4.*",
        "psr/http-client": "^1.0",
        "bjeavons/zxcvbn-php": "^1.3",
        "symfony/cache": "7.4.*",
        "symfony/clock": "7.4.*",
        "symfony/config": "7.4.*",
        "symfony/console": "7.4.*",
        "symfony/dependency-injection": "7.4.*",
        "symfony/error-handler": "7.4.*",
        "symfony/event-dispatcher": "7.4.*",
        "symfony/filesystem": "7.4.*",
        "symfony/finder": "7.4.*",
        "symfony/http-foundation": "7.4.*",
        "symfony/http-kernel": "7.4.*",
        "symfony/password-hasher": "7.4.*",
        "symfony/property-access": "7.4.*",
        "symfony/property-info": "7.4.*",
        "symfony/routing": "7.4.*",
        "symfony/security-core": "7.4.*",
        "symfony/security-csrf": "7.4.*",
        "symfony/security-http": "7.4.*",
        "symfony/string": "7.4.*",
        "symfony/type-info": "7.4.*",
        "symfony/var-dumper": "7.4.*",
        "symfony/var-exporter": "7.4.*"
    },
    "autoload": {
        "psr-4": {
            "sgoranov\\IdentityLinkShared\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "sgoranov\\IdentityLinkShared\\Tests\\": "tests/"
        }
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "config": {
        "allow-plugins": {
            "symfony/runtime": false
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "scripts": {
        "test": "phpunit"
    }
}
